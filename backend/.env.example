DATABASE_URL="file:./dev.db"
PORT=3000

# Redis for BullMQ (Provide your Upstash or local Redis URL)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Elasticsearch (Provide your Elastic Cloud or local URL)
ELASTIC_NODE="http://localhost:9200"
ELASTIC_API_KEY=""

# Slack Webhook for Rate Limit Notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Nodemailer Ethereal config (Will be auto-generated in worker.ts if empty, but good to have)
ETHEREAL_USER=""
ETHEREAL_PASS=""
